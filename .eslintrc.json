{
  "env": {
    "browser": true,
    "es2021": true,
    "commonjs": true
  },
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "plugins": [
    "no-unsanitized"
  ],
  "rules": {
    "no-unsanitized/method": "warn",
    "no-unsanitized/property": "warn",
    "no-eval": "warn",
    "no-implied-eval": "warn"
  }
}
