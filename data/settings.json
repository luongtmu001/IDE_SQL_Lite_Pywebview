{
    "editor": {
        "fontFamily": "JetBrains Mono",
        "fontSize": 14,
        "tabSize": 4,
        "minimap": true,
        "insertSpaces": false,
        "lineHeight": 1.5,
        "letterSpacing": 0
    },
    "appearance": {
        "theme": "github-light-default-light",
        "uiFontFamily": "Inter",
        "uiFontSize": 14
    },
    "addons": {
        "bravo_tool": {
            "enabled": true
        }
    },
    "grid": {
        "fontFamily": "Cascadia Code",
        "fontSize": 14
    },
    "messages": {
        "fontFamily": "Source Code Pro",
        "fontSize": 13
    },
    "theme": "github-light-default-light",
    "sql": {
        "maxRows": 1000,
        "timeoutSeconds": 30,
        "sqlprotection": 1
    }
}